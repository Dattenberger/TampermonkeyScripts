{
    "name": "tampermonkey-scripts",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prepare": "node scripts/install-hooks.mjs",
        "build": "tsx build.ts",
        "build:script": "tsx build.ts",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "bash scripts/hooks/pre-commit --all",
        "check:staged": "bash scripts/hooks/pre-commit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.12.0",
        "@typescript-eslint/utils": "^8.48.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-unicorn": "^60.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "jsdom": "^28.0.0",
        "prettier": "^3.4.2",
        "tsx": "^4.19.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^8.0.0",
        "vite-plugin-monkey": "^8.0.0",
        "vitest": "^4.1.5"
    }
}
