#!/usr/bin/env bash
# Pre-commit hook for the Tampermonkey-Scripts repo.
#
# Activation: `git config core.hooksPath scripts/hooks` (done by the
# `prepare` lifecycle script — see scripts/install-hooks.mjs).
#
# Two modes:
#   - 'staged' (default, git-commit context): pre-filter sub-checks
#     against the staged file-set — fast feedback during normal commits.
#   - 'all' (full-worktree sanity-check): bypass every staged-file
#     pre-filter and run the full repo against each sub-check.
#     Triggered via `--all` flag, `CHECK_ALL=1` env-var, or `npm run check`.
#
# Sub-checks (in order):
#   1. ESLint                — SKIP_LINT=1
#   2. tsc --noEmit          — SKIP_TYPECHECK=1
#   3. Vitest                — SKIP_TESTS=1
#   4. Vite build + dist     — SKIP_BUILD=1
#
# Skip everything via `git commit --no-verify` (leaves a trail).

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Mode detection ─────────────────────────────────────────────────────
MODE="staged"
if [[ "${1:-}" == "--all" || "${CHECK_ALL:-0}" == "1" ]]; then
    MODE="all"
fi

# Locate ourselves: the hook lives at pipeline/scripts/hooks/pre-commit.
# All npm commands run from pipeline/. Git operations work regardless of
# cwd (they reference the surrounding repo), and `git diff --cached
# --name-only` reports paths relative to cwd — which means root-level
# legacy .js files show as `../<file>.js` and are correctly excluded
# from the TS-relevance heuristic below.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PIPELINE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "$PIPELINE_DIR"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

if [ "$MODE" = "all" ]; then
    echo -e "${BLUE}=== Pre-commit hook (mode: ALL — full worktree) ===${NC}"
else
    echo -e "${BLUE}=== Pre-commit hook (mode: STAGED) === [${GREEN}${BRANCH}${NC}]${BLUE}${NC}"
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

# Heuristic: do we need to run TS-aware checks at all?
should_run_ts_checks() {
    if [ "$MODE" = "all" ]; then return 0; fi
    if echo "$STAGED" | grep -qE '\.(ts|mts|cts|tsx)$|^tsconfig.*\.json$|^package(-lock)?\.json$|^eslint\.config\.|^scripts\.config\.|^vite\.config\.|^vitest\.config\.|^build\.ts$'; then
        return 0
    fi
    return 1
}

# 1. ESLint ──────────────────────────────────────────────────────────
if [ "${SKIP_LINT:-0}" = "1" ]; then
    echo -e "${YELLOW}WARNING: SKIP_LINT=1 — lint skipped${NC}"
elif should_run_ts_checks; then
    echo -e "${BLUE}Running ESLint...${NC}"
    if ! npm run lint --silent; then
        echo -e "${RED}ESLint failed. Fix: ${YELLOW}npm run lint:fix${NC}"
        exit 1
    fi
    echo -e "${GREEN}ESLint passed${NC}"
else
    echo -e "${BLUE}No TS-relevant files staged — skipping ESLint${NC}"
fi

# 2. tsc --noEmit ────────────────────────────────────────────────────
if [ "${SKIP_TYPECHECK:-0}" = "1" ]; then
    echo -e "${YELLOW}WARNING: SKIP_TYPECHECK=1 — tsc skipped${NC}"
elif should_run_ts_checks; then
    echo -e "${BLUE}Running tsc --noEmit...${NC}"
    if ! npm run typecheck --silent; then
        echo -e "${RED}Typecheck failed${NC}"
        exit 1
    fi
    echo -e "${GREEN}Typecheck passed${NC}"
else
    echo -e "${BLUE}No TS-relevant files staged — skipping typecheck${NC}"
fi

# 3. Vitest ──────────────────────────────────────────────────────────
if [ "${SKIP_TESTS:-0}" = "1" ]; then
    echo -e "${YELLOW}WARNING: SKIP_TESTS=1 — tests skipped${NC}"
elif should_run_ts_checks; then
    echo -e "${BLUE}Running Vitest...${NC}"
    if ! npm test --silent; then
        echo -e "${RED}Tests failed${NC}"
        exit 1
    fi
    echo -e "${GREEN}Tests passed${NC}"
else
    echo -e "${BLUE}No TS-relevant files staged — skipping tests${NC}"
fi

# 4. Vite build + dist staging ───────────────────────────────────────
# Always rebuild when any TS-relevant or scripts.config change is staged,
# stage the resulting dist/, and verify nothing else drifted on disk.
if [ "${SKIP_BUILD:-0}" = "1" ]; then
    echo -e "${YELLOW}WARNING: SKIP_BUILD=1 — build skipped${NC}"
elif should_run_ts_checks; then
    echo -e "${BLUE}Running build...${NC}"
    if ! npm run build --silent; then
        echo -e "${RED}Build failed${NC}"
        exit 1
    fi
    if [ -d dist ]; then
        git add dist/
        if git diff --cached --quiet dist/ 2>/dev/null; then
            echo -e "${GREEN}Build succeeded — dist/ unchanged${NC}"
        else
            echo -e "${GREEN}Build succeeded — dist/ updated and staged${NC}"
            echo -e "${YELLOW}Consider bumping the version in scripts.config.ts before merging.${NC}"
        fi
    else
        echo -e "${GREEN}Build succeeded — no dist/ output (empty registry)${NC}"
    fi
else
    echo -e "${BLUE}No TS-relevant files staged — skipping build${NC}"
fi

echo -e "${GREEN}Pre-commit passed${NC}"
exit 0
